# ============================================================
# Discord AI 기획팀 봇 설정 파일
# - Discord·Notion 토큰과 ID만 채우면 된다. 나머지는 기본값으로 동작한다.
#   (채워야 할 항목은 setup.cmd 실행 시 마지막에 안내된다)
# - 일반 텍스트 파일이며 별도 비밀번호는 없다.
# - .gitignore에 포함되어 Git에 올라가지 않는다. 토큰/키는 채팅·메신저에 공유하지 않는다.
# - 값은 '=' 바로 뒤에 따옴표·공백 없이 입력한다.
# - 주석은 줄 맨 앞에 '#'으로만 쓴다. 값 뒤에 주석을 붙이지 않는다.
# - 수정 후 봇을 재시작해야 반영된다.
# ============================================================

# ---------- Discord ----------
# 봇 토큰 (비밀값): Developer Portal > 애플리케이션 > Bot > Reset Token
DISCORD_TOKEN=
# 서버 ID: Discord 설정에서 개발자 모드 켜기 > 서버 이름 우클릭 > ID 복사
DISCORD_GUILD_ID=
# 회의 채널 ID: /plan을 실행할 텍스트 채널 우클릭 > ID 복사
DISCORD_CHANNEL_ID=
# 봇 사용을 허용할 사용자 ID. 여러 명이면 쉼표로 구분 (예: 111,222)
ALLOWED_USER_IDS=
# 회의 대화 위치: false=회의 채널에서 바로 대화, true=회의마다 별도 스레드 생성
# true면 봇에 Create Public Threads 권한이 필요하다
MEETING_IN_THREAD=false

# ---------- AI 모델 ----------
# 사용할 AI: ollama(무료, 내 PC에서 실행) 또는 openai(유료 API)
LLM_PROVIDER=ollama

# [Ollama] LLM_PROVIDER=ollama 일 때 사용
# Ollama 서버 주소. 봇을 Docker로 실행하면 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# 사용할 모델. 바꾸면 먼저 'ollama pull 모델명'으로 내려받아야 한다
#   gemma3:4b       약 3.3GB, 빠름, 한국어 무난 (기본 추천)
#   exaone3.5:7.8b  약 4.8GB, 한국어 특화, 느림, 비상업 라이선스
#   qwen2.5:7b      약 4.7GB, 기획·논리 품질 좋음, 느림
#   exaone3.5:2.4b  약 1.6GB, 가장 빠름, 내용이 얕음
OLLAMA_MODEL=gemma3:4b
# 모델이 한 번에 읽는 최대 토큰 수. 8192 미만이면 PM 종합 단계 입력이 잘릴 수 있다
# 늘리면 VRAM/RAM 사용량이 늘어난다
OLLAMA_NUM_CTX=8192
# 봇 시작 시 Ollama 서버가 뜰 때까지 기다리는 최대 시간(초). 비워두면 120
# 로그인 자동 실행 직후 Ollama 앱보다 봇이 먼저 시작되는 경우에 대비한다
OLLAMA_STARTUP_WAIT_SECONDS=

# [OpenAI] LLM_PROVIDER=openai 일 때만 필요
# API 키 (비밀값): platform.openai.com > API keys. ChatGPT 구독과 별도 결제
OPENAI_API_KEY=
# Responses API를 지원하는 모델 이름
OPENAI_MODEL=gpt-4.1-mini

# ---------- 제한 시간 (초) ----------
# 비워두면 기본값 사용: ollama 600/1800, openai 90/900
# 모델 호출 1회의 최대 대기 시간
LLM_TIMEOUT_SECONDS=
# 회의 1건(모델 호출 9회) 전체 최대 시간. 넘으면 회의는 failed 처리
MEETING_TIMEOUT_SECONDS=

# ---------- Notion ----------
# 내부 통합 토큰 (비밀값): notion.so/profile/integrations > 통합 선택 > 내부 통합 시크릿
NOTION_TOKEN=
# 회의록을 저장할 부모 페이지 ID: 페이지 URL 끝 32자리만 입력 (URL 전체 X)
# 해당 페이지 우측 상단 ... > 연결 메뉴에서 통합을 추가해야 접근 가능
NOTION_PARENT_PAGE_ID=
# Notion API 버전. 코드가 이 버전 기준으로 작성되어 변경 비권장
NOTION_VERSION=2022-06-28

# ---------- 저장 ----------
# 회의 기록(JSON) 저장 폴더
DATA_DIR=./data
